# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_SOURCE_CHANNEL_ID=-1001234567890
TELEGRAM_REPORT_CHAT_ID=-1009876543210

# PostgreSQL
POSTGRES_DB=weeklyreport
POSTGRES_USER=weeklyreport
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=6868

# Лимит памяти контейнера app (необязательно, по умолчанию 1g). Внутри лимита JVM берёт
# под heap 75% - оставьте хосту запас на postgres и систему.
APP_MEM_LIMIT=1g

# Расписание недельного отчёта (необязательно - есть значения по умолчанию)
WEEKLY_REPORT_CRON=0 0 9 * * MON
WEEKLY_REPORT_TIMEZONE=Asia/Almaty

DIVISIONS_FILE_PATH=data/divisions.xlsx
DARIBAR_CROSSWALK_PATH=data/daribar_crosswalk.xlsx

SMTP_HOST=mail.inkar.kz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example@inkar.kz
SMTP_PASSWORD=
